<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    android:padding="8dp">

    <ru.tolmach.translator.BreadcrumbsView
        android:id="@+id/crumbs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- ==================== ВЕРХНЯЯ ПОЛОВИНА ==================== -->
        <LinearLayout
            android:id="@+id/paneTop"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pane"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/headerTop"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/titleTop"
                    style="@style/Widget.Tolmach.PaneTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="@string/cd_swap"
                    android:drawableStart="@drawable/ic_swap"
                    android:drawablePadding="8dp"
                    android:text="@string/lang_russian" />

                <ImageButton
                    android:id="@+id/themeTop"
                    style="@style/Widget.Tolmach.IconButton"
                    android:contentDescription="@string/cd_theme"
                    android:src="@drawable/ic_theme" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/fontDownTop"
                    style="@style/Widget.Tolmach.HeaderButton"
                    android:text="@string/font_down" />

                <TextView
                    android:id="@+id/fontUpTop"
                    style="@style/Widget.Tolmach.HeaderButton"
                    android:text="@string/font_up" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/earTop"
                    style="@style/Widget.Tolmach.IconButton"
                    android:contentDescription="@string/cd_speak"
                    android:src="@drawable/ic_ear" />

                <ImageButton
                    android:id="@+id/pasteTop"
                    style="@style/Widget.Tolmach.IconButton"
                    android:contentDescription="@string/cd_paste"
                    android:src="@drawable/ic_paste" />

                <ImageButton
                    android:id="@+id/copyTop"
                    style="@style/Widget.Tolmach.IconButton"
                    android:contentDescription="@string/cd_copy"
                    android:src="@drawable/ic_copy" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/colorOutlineVariant" />

            <EditText
                android:id="@+id/editTop"
                style="@style/Widget.Tolmach.PaneInput"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:hint="@string/input_hint" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <!-- ==================== НИЖНЯЯ ПОЛОВИНА ==================== -->
        <LinearLayout
            android:id="@+id/paneBottom"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pane"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/headerBottom"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/titleBottom"
                    style="@style/Widget.Tolmach.PaneTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="@string/cd_swap"
                    android:drawableStart="@drawable/ic_swap"
                    android:drawablePadding="8dp"
                    android:text="@string/lang_english" />

                <ImageButton
                    android:id="@+id/themeBottom"
                    style="@style/Widget.Tolmach.IconButton"
                    android:contentDescription="@string/cd_theme"
                    android:src="@drawable/ic_theme" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/fontDownBottom"
                    style="@style/Widget.Tolmach.HeaderButton"
                    android:text="@string/font_down" />

                <TextView
                    android:id="@+id/fontUpBottom"
                    style="@style/Widget.Tolmach.HeaderButton"
                    android:text="@string/font_up" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/earBottom"
                    style="@style/Widget.Tolmach.IconButton"
                    android:contentDescription="@string/cd_speak"
                    android:src="@drawable/ic_ear" />

                <ImageButton
                    android:id="@+id/pasteBottom"
                    style="@style/Widget.Tolmach.IconButton"
                    android:contentDescription="@string/cd_paste"
                    android:src="@drawable/ic_paste" />

                <ImageButton
                    android:id="@+id/copyBottom"
                    style="@style/Widget.Tolmach.IconButton"
                    android:contentDescription="@string/cd_copy"
                    android:src="@drawable/ic_copy" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/colorOutlineVariant" />

            <EditText
                android:id="@+id/editBottom"
                style="@style/Widget.Tolmach.PaneInput"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:hint="@string/input_hint" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="6dp"
        android:paddingBottom="2dp"
        android:text="@string/status_idle"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp" />

</LinearLayout>
